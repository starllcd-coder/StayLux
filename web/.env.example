DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

# Optional staff job push. Leave disabled until Firebase credentials are ready.
FIREBASE_PUSH_ENABLED=0
FIREBASE_SERVICE_ACCOUNT_FILE=

# Stable Fernet encryption key for channel API credentials. Store in Render secrets.
CHANNEL_CREDENTIALS_KEY=
TIME_ZONE=Asia/Muscat
LANGUAGE_CODE=en
